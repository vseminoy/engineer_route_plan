# Настройки стенда Docker Compose: cp .env.example .env
POSTGRES_USER=route_plan
POSTGRES_PASSWORD=route_plan_dev
POSTGRES_DB=engineer_route_plan
# Пароли ролей, которые создаёт миграция: app_rw — приложение (данные, без права менять
# схему), app_ro — ручные запросы только на чтение. Входят в адрес БД — без символов
# @ : / ? # %.
APP_RW_PASSWORD=app_rw_dev
APP_RO_PASSWORD=app_ro_dev

# Часовой пояс региона: всё время в БД и API — местное, без пересчёта в UTC.
TZ=Europe/Moscow

APP_MODE=demo
LOG_LEVEL=INFO

# Предел тела запроса в байтах (1 МБ): больше — 413. Файл из 500 заявок — до ~0,5 МБ
# (JSON с кириллицей в виде \uXXXX), CSV — около 100 КБ.
MAX_REQUEST_BODY_BYTES=1048576

# Запасной геокодер для адресов, которых нет в гео-кэше: https://nominatim.openstreetmap.org.
# Пусто — выключен: стенду не нужен интернет, демо-наборы и исходные файлы грузятся из кэша.
NOMINATIM_URL=

# Время в пути на общественном транспорте = время на машине × коэффициент (не меньше 1):
# усреднённая поправка на пересадки, ожидание и пешие участки.
PUBLIC_TRANSPORT_FACTOR=1.5
# Наибольшая матрица времени в пути, которую osrm-routed считает за один запрос (точек);
# матрицу больше backend запрашивает частями.
OSRM_MAX_TABLE_SIZE=1000
# Предел ожидания одного ответа OSRM, секунды: матрица дня региона (до 530 точек) на графе
# bike считается до ~26 с.
OSRM_TIMEOUT_S=60
# Бюджет времени одного построения плана or_tools (три фазы вместе), секунды: план
# строится в фоне после ответа POST /plan/build, так что общего дедлайна запроса нет —
# только этот бюджет солвера и собственный таймаут клиента OSRM.
SOLVER_TIME_LIMIT_S=30

# Интерфейс, на котором слушает стенд. API без аутентификации: 0.0.0.0 открывает его
# всем в локальной сети — только осознанно.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8080
# Прямой доступ к backend с хоста (/docs).
BACKEND_PORT=8001
# Доступ к БД с хоста (только 127.0.0.1) для клиента БД; для ручных запросов — роль app_ro.
DB_PORT=5432
