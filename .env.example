# Настройки стенда Docker Compose: cp .env.example .env
POSTGRES_USER=route_plan
POSTGRES_PASSWORD=route_plan_dev
POSTGRES_DB=engineer_route_plan

APP_MODE=demo
LOG_LEVEL=INFO

# Предел тела запроса в байтах (10 МБ): больше — 413.
MAX_REQUEST_BODY_BYTES=10485760

# Выгрузка OSM для графа дорог. Покрывает Москву и Московскую область (Домодедово,
# Кашира, Ступино). При смене URL граф пересобирается при следующем `up`, и osrm
# перезапускается с новым графом.
OSRM_PBF_URL=https://download.geofabrik.de/russia/central-fed-district-latest.osm.pbf

# Интерфейс, на котором слушает стенд. API без аутентификации: 0.0.0.0 открывает его
# всем в локальной сети — только осознанно.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8080
# Прямой доступ к backend с хоста (/docs).
BACKEND_PORT=8001
