# Скопируйте в back/.env и заполните реальными значениями для локального запуска.
DATABASE_URL=postgresql://user:pass@localhost:5432/engineer_route_plan
OSRM_URL=http://localhost:5000
APP_MODE=demo
LOG_LEVEL=INFO
LOG_FORMAT=console
# Предел тела запроса в байтах (10 МБ): больше — 413 без тела.
MAX_REQUEST_BODY_BYTES=10485760
