# Скопируйте в back/.env и заполните реальными значениями для локального запуска.
# БД стенда (make up) под ролью приложения app_rw; пароль — APP_RW_PASSWORD из корневого .env.
DATABASE_URL=postgresql://app_rw:app_rw_dev@127.0.0.1:5432/engineer_route_plan
# osrm-routed по профилям: у каждого профиля свой граф. Сервисы osrm-* стенда на хост не
# опубликованы — для вызовов OSRM из `make run` нужен свой osrm-routed на этих портах.
OSRM_URL_CAR=http://localhost:5000
OSRM_URL_FOOT=http://localhost:5001
OSRM_URL_BIKE=http://localhost:5002
# Время на общественном транспорте = время на машине × коэффициент (не меньше 1).
# PUBLIC_TRANSPORT_FACTOR=1.5
# --max-table-size серверов OSRM; матрицу больше клиент запрашивает частями.
# OSRM_MAX_TABLE_SIZE=1000
# Предел ожидания одного ответа OSRM, секунды.
# OSRM_TIMEOUT_S=60
APP_MODE=demo
LOG_LEVEL=INFO
LOG_FORMAT=console
# Предел тела запроса в байтах (1 МБ): больше — 413 без тела.
MAX_REQUEST_BODY_BYTES=1048576
# Запасной геокодер для адресов, которых нет в data/geocache.csv; пусто — выключен.
# Демо-наборы и исходные файлы грузятся из кэша и без него.
NOMINATIM_URL=
# Сколько адресов, которых нет в кэше, одна загрузка отправляет в геокодер (по умолчанию 50).
# NOMINATIM_MAX_LOOKUPS=50
